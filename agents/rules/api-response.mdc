## 8) Implementation Reference

### Global Success Interceptor

typescript
import {
  CallHandler,
  ExecutionContext,
  Injectable,
  NestInterceptor,
} from '@nestjs/common';
import { Request, Response } from 'express';
import { Observable } from 'rxjs';
import { map } from 'rxjs/operators';
import { ApiSuccessResponse } from './interfaces/api-response.interface';

@Injectable()
export class ApiSuccessInterceptor<T>
  implements NestInterceptor<T, ApiSuccessResponse<T>>
{
  intercept(
context: ExecutionContext,
next: CallHandler<T>,
  ): Observable<ApiSuccessResponse<T>> {
const ctx = context.switchToHttp();
const req = ctx.getRequest<Request>();
const res = ctx.getResponse<Response>();

return next.handle().pipe(
map((payload: any) => {
const isWrapped =
payload &&
typeof payload === 'object' &&
'data' in payload &&
'message' in payload;

const data = isWrapped ? payload.data : payload;
const message = isWrapped
? payload.message
: 'Operation completed successfully';

return {
statusCode: res.statusCode,
message,
data,
path: req.originalUrl,
};
}),
);
  }
}

Register in `main.ts`:
typescript
app.useGlobalInterceptors(new ApiSuccessInterceptor());

### Global Validation Pipe

typescript
import { BadRequestException, ValidationPipe } from '@nestjs/common';
import { ValidationError } from 'class-validator';
import { ApiErrorDetail } from './interfaces/api-response.interface';

app.useGlobalPipes(
  new ValidationPipe({
whitelist: true,
transform: true,
exceptionFactory: (validationErrors: ValidationError[]) => {
const errors: ApiErrorDetail[] = [];

const flatten = (errs: ValidationError[], parent = '') => {
for (const e of errs) {
const field = parent ? `${parent}.${e.property}` : e.property;
if (e.constraints) {
errors.push({
field,
messages: Object.values(e.constraints),
value: e.value ?? null,
});
}
if (e.children?.length) flatten(e.children, field);
}
};

flatten(validationErrors);
return new BadRequestException({
message: 'Input validation failed',
errors,
});
},
  }),
);

### Global Exception Filter

typescript
import {
  ArgumentsHost,
  Catch,
  ExceptionFilter,
  HttpException,
  HttpStatus,
} from '@nestjs/common';
import { Request, Response } from 'express';
import {
  ApiErrorDetail,
  ApiErrorResponse,
} from './interfaces/api-response.interface';

@Catch()
export class ApiExceptionFilter implements ExceptionFilter {
  catch(exception: unknown, host: ArgumentsHost) {
const ctx = host.switchToHttp();
const res = ctx.getResponse<Response>();
const req = ctx.getRequest<Request>();

let statusCode = HttpStatus.INTERNAL_SERVER_ERROR;
let message = 'Internal server error';
let errors: ApiErrorDetail[] | Record<string, unknown> | [] = [];

if (exception instanceof HttpException) {
statusCode = exception.getStatus();
const body = exception.getResponse();

if (typeof body === 'string') {
message = body;
} else if (body && typeof body === 'object') {
const b = body as Record<string, any>;
if (typeof b.message === 'string') message = b.message;
else if (Array.isArray(b.message)) {
errors = b.message.map((m: string) => ({ message: m }));
}
if (b.errors) errors = b.errors;
}
} else {
// ⛔ Log full details server-side only — never expose to client
console.error('Unhandled exception:', exception);
}

const payload: ApiErrorResponse = {
statusCode,
message,
errors,
path: req.originalUrl,
};
res.status(statusCode).json(payload);
  }
}

